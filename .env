# Variables de WhatsApp (Meta)
WA_ACCESS_TOKEN=tu_token_permanente
WA_PHONE_NUMBER_ID=tu_phone_number_id
WA_APP_SECRET=tu_app_secret
WA_VERIFY_TOKEN=tu_verify_token

# Variables de Inteligencia Artificial (DeepSeek)
DEEPSEEK_API_KEY=tu_api_key_de_deepseek
DEEPSEEK_MODEL=deepseek-flash

# Variables de Integración (n8n)
N8N_WEBHOOK_URL=tu_url_del_webhook
N8N_SHARED_SECRET=tu_token_secreto_para_n8n

# Variables de Base de Datos (Firebird / Microsip)
FB_HOST=localhost
FB_PORT=3050
FB_DATABASE=C:/ruta/a/tu/base/de/datos.fdb
FB_USER=SYSDBA
FB_PASSWORD=tu_contraseña_firebird

# Parámetros del ERP y Control de Pedidos
MSIP_LISTA_PRECIOS_ID=1
MSIP_ALMACEN_ID=1
MSIP_SERIE_PEDIDO=XP
PEDIDOS_ESCRITURA=false